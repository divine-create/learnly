generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model School {
  id          String   @id @default(cuid())
  name        String
  state       String
  lga         String
  type        String
  code        String   @unique
  plan        String   @default("starter")
  planExpiry  DateTime?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users         User[]
  classes       Class[]
  quizzes       Quiz[]
  announcements Announcement[]
  termPeriods   TermPeriod[]
  dailyChallenges DailyChallenge[]
}

model User {
  id           String   @id @default(cuid())
  schoolId     String?
  role         String
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  gradeLevel   String?
  isActive     Boolean  @default(true)
  darkMode     Boolean  @default(false)
  createdAt    DateTime @default(now())

  school               School?              @relation(fields: [schoolId], references: [id])
  taughtClasses        Class[]              @relation("TeacherClasses")
  classEnrollments     ClassStudent[]
  tutorSessions        TutorSession[]
  tutorMessages        TutorMessage[]
  quizAttempts         QuizAttempt[]
  studentXp            StudentXP?
  studentBadges        StudentBadge[]
  uploadedMaterials    Material[]
  children             ParentChild[]        @relation("ParentChildren")
  parents              ParentChild[]        @relation("ChildParents")
  lessonProgress       LessonProgress[]
  assignmentSubmissions AssignmentSubmission[]
  attendanceRecords    Attendance[]
  screenTime           ScreenTime[]
  sentMessages         Message[]            @relation("SentMessages")
  receivedMessages     Message[]            @relation("ReceivedMessages")
  dailyChallengeAttempts DailyChallengeAttempt[]
  announcements        Announcement[]
  studentNotes         StudentNote[]
  examCountdowns       ExamCountdown[]
}

model ParentChild {
  parentId   String
  childId    String
  status     String    @default("pending") // pending | approved | rejected
  createdAt  DateTime  @default(now())
  approvedAt DateTime?
  parent     User      @relation("ParentChildren", fields: [parentId], references: [id])
  child      User      @relation("ChildParents", fields: [childId], references: [id])
  @@id([parentId, childId])
}

model Class {
  id         String   @id @default(cuid())
  schoolId   String
  teacherId  String
  name       String
  gradeLevel String
  subject    String
  code       String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  school        School         @relation(fields: [schoolId], references: [id])
  teacher       User           @relation("TeacherClasses", fields: [teacherId], references: [id])
  students      ClassStudent[]
  lessons       Lesson[]
  assignments   Assignment[]
  attendanceLogs Attendance[]
  announcements Announcement[]
}

model ClassStudent {
  classId   String
  studentId String
  joinedAt  DateTime @default(now())
  class   Class @relation(fields: [classId], references: [id])
  student User  @relation(fields: [studentId], references: [id])
  @@id([classId, studentId])
}

model TermPeriod {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id])
}

model Lesson {
  id          String   @id @default(cuid())
  classId     String
  title       String
  topic       String
  description String?
  richContent String?  // HTML from lesson builder
  orderIndex  Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  class      Class            @relation(fields: [classId], references: [id])
  materials  Material[]
  quizzes    Quiz[]
  sessions   TutorSession[]
  progress   LessonProgress[]
  flashcards Flashcard[]
}

model Material {
  id         String   @id @default(cuid())
  lessonId   String
  teacherId  String
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  status     String   @default("processing")
  createdAt  DateTime @default(now())

  lesson  Lesson          @relation(fields: [lessonId], references: [id])
  teacher User            @relation(fields: [teacherId], references: [id])
  chunks  MaterialChunk[]
}

model MaterialChunk {
  id         String                       @id @default(cuid())
  materialId String
  chunkText  String
  chunkIndex Int
  embedding  Unsupported("vector(768)")?
  metadata   String                       @default("{}")
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  id          String    @id @default(cuid())
  lessonId    String
  studentId   String
  completed   Boolean   @default(false)
  completedAt DateTime?
  timeSpent   Int       @default(0)
  lesson  Lesson @relation(fields: [lessonId], references: [id])
  student User   @relation(fields: [studentId], references: [id])
  @@unique([lessonId, studentId])
}

model Flashcard {
  id       String @id @default(cuid())
  lessonId String
  front    String
  back     String
  order    Int    @default(0)
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String    @id @default(cuid())
  classId     String
  title       String
  description String
  dueDate     DateTime
  maxScore    Int       @default(100)
  language    String    @default("python")
  starterCode String?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())

  class       Class                  @relation(fields: [classId], references: [id])
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  code         String
  score        Int?
  feedback     String?
  submittedAt  DateTime  @default(now())
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])
  @@unique([assignmentId, studentId])
}

model Attendance {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  date      String   // YYYY-MM-DD
  status    String   @default("present") // present | absent | late
  note      String?
  class   Class @relation(fields: [classId], references: [id])
  student User  @relation(fields: [studentId], references: [id])
  @@unique([classId, studentId, date])
}

model Announcement {
  id        String   @id @default(cuid())
  schoolId  String?
  classId   String?
  authorId  String
  title     String
  content   String
  priority  String   @default("normal") // normal | urgent
  createdAt DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id])
  class  Class?  @relation(fields: [classId], references: [id])
  author User    @relation(fields: [authorId], references: [id])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  subject     String
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender    User @relation("SentMessages", fields: [senderId], references: [id])
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id])
}

model DailyChallenge {
  id          String   @id @default(cuid())
  schoolId    String?
  date        String   @unique // YYYY-MM-DD
  title       String
  description String
  language    String   @default("python")
  starterCode String
  solution    String
  xp          Int      @default(50)
  difficulty  String   @default("easy")

  school   School?                  @relation(fields: [schoolId], references: [id])
  attempts DailyChallengeAttempt[]
}

model DailyChallengeAttempt {
  id          String   @id @default(cuid())
  challengeId String
  studentId   String
  code        String
  passed      Boolean  @default(false)
  submittedAt DateTime @default(now())

  challenge DailyChallenge @relation(fields: [challengeId], references: [id])
  student   User           @relation(fields: [studentId], references: [id])
  @@unique([challengeId, studentId])
}

model ScreenTime {
  id        String   @id @default(cuid())
  studentId String
  date      String   // YYYY-MM-DD
  minutes   Int      @default(0)
  student User @relation(fields: [studentId], references: [id])
  @@unique([studentId, date])
}

model TutorSession {
  id        String    @id @default(cuid())
  studentId String
  lessonId  String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  student  User           @relation(fields: [studentId], references: [id])
  lesson   Lesson?        @relation(fields: [lessonId], references: [id])
  messages TutorMessage[]
}

model TutorMessage {
  id         String   @id @default(cuid())
  sessionId  String
  studentId  String
  role       String
  content    String
  chunksUsed String   @default("[]")
  createdAt  DateTime @default(now())
  session TutorSession @relation(fields: [sessionId], references: [id])
  student User         @relation(fields: [studentId], references: [id])
}

model Quiz {
  id               String   @id @default(cuid())
  lessonId         String
  schoolId         String
  title            String
  timeLimitSeconds Int      @default(300)
  status           String   @default("draft")
  totalXp          Int      @default(100)
  createdAt        DateTime @default(now())

  lesson    Lesson        @relation(fields: [lessonId], references: [id])
  school    School        @relation(fields: [schoolId], references: [id])
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id           String  @id @default(cuid())
  quizId       String
  type         String
  question     String
  options      String
  correctIndex Int
  explanation  String
  xp           Int     @default(10)
  orderIndex   Int     @default(0)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  studentId   String
  score       Int
  xpEarned    Int
  timeTaken   Int
  answers     String
  completedAt DateTime @default(now())
  quiz    Quiz @relation(fields: [quizId], references: [id])
  student User @relation(fields: [studentId], references: [id])
}

model StudentXP {
  studentId  String   @id
  totalXp    Int      @default(0)
  streakDays Int      @default(0)
  lastActive DateTime @default(now())
  student User @relation(fields: [studentId], references: [id])
}

model Badge {
  id          String @id @default(cuid())
  name        String
  description String
  icon        String
  condition   String
  xpRequired  Int    @default(0)
  studentBadges StudentBadge[]
}

model StudentBadge {
  studentId String
  badgeId   String
  earnedAt  DateTime @default(now())
  student User  @relation(fields: [studentId], references: [id])
  badge   Badge @relation(fields: [badgeId], references: [id])
  @@id([studentId, badgeId])
}

model StudentNote {
  id        String   @id @default(cuid())
  studentId String
  title     String
  content   String
  lessonId  String?
  isAI      Boolean  @default(false)
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ExamCountdown {
  id        String   @id @default(cuid())
  studentId String
  subject   String
  date      String
  time      String   @default("09:00")
  notes     String?
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
